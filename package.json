{
  "name": "doc-tales",
  "version": "0.1.0",
  "description": "Smart Document & Feed Unification Processor",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "./run-tests.sh",
    "test:integration": "./integration-tests.sh",
    "test:integration:dev": "./integration-tests.sh dev",
    "test:integration:staging": "./integration-tests.sh staging",
    "test:integration:prod": "./integration-tests.sh prod",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "start:frontend": "npm run start -w @doc-tales/frontend",
    "start:backend": "./infrastructure/scripts/start-local.sh",
    "build:frontend": "npm run build -w @doc-tales/frontend",
    "build:backend": "npm run build -w @doc-tales/backend",
    "build:common": "npm run build -w @doc-tales/common",
    "deploy:frontend": "./infrastructure/scripts/deploy-frontend.sh",
    "deploy:backend": "./infrastructure/scripts/deploy-backend.sh dev",
    "deploy:backend:dev": "./infrastructure/scripts/deploy-backend.sh dev",
    "deploy:backend:staging": "./infrastructure/scripts/deploy-backend.sh staging",
    "deploy:backend:prod": "./infrastructure/scripts/deploy-backend.sh prod",
    "deploy:all": "npm run build && npm run deploy:backend && npm run deploy:frontend",
    "demo:seed": "./seed-demo-data.sh",
    "demo:seed:dev": "./seed-demo-data.sh dev",
    "demo:seed:staging": "./seed-demo-data.sh staging",
    "demo:cleanup": "./cleanup-demo-data.sh",
    "demo:cleanup:dev": "./cleanup-demo-data.sh dev",
    "demo:cleanup:staging": "./cleanup-demo-data.sh staging",
    "demo:prepare": "npm run demo:cleanup && npm run demo:seed && npm run test:integration",
    "demo:validate": "./validate-demo.sh",
    "demo:validate:dev": "./validate-demo.sh dev",
    "demo:validate:staging": "./validate-demo.sh staging"
  },
  "keywords": [
    "document",
    "processing",
    "aws",
    "lambda",
    "hackathon"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "aws-sdk": "^2.1354.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "typescript": "^4.5.5"
  }
}

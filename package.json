{
  "name": "doc-tales",
  "version": "0.1.0",
  "description": "Smart Document & Feed Unification Processor",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "test": "./scripts/test/run-tests.sh dev us-east-1 unit",
    "test:all": "./scripts/test/run-tests.sh dev us-east-1 all",
    "test:unit": "./scripts/test/run-tests.sh dev us-east-1 unit",
    "test:integration": "./scripts/test/run-tests.sh dev us-east-1 integration",
    "test:integration:dev": "./scripts/test/run-tests.sh dev us-east-1 integration",
    "test:integration:staging": "./scripts/test/run-tests.sh staging us-east-1 integration",
    "test:ml": "./scripts/test/run-tests.sh dev us-east-1 ml",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "start:frontend": "npm run start -w @doc-tales/frontend",
    "start:backend": "./infrastructure/scripts/start-local.sh",
    "build:frontend": "npm run build -w @doc-tales/frontend",
    "build:backend": "npm run build -w @doc-tales/backend",
    "build:common": "npm run build -w @doc-tales/common",
    "deploy:frontend": "./infrastructure/scripts/deploy-frontend.sh",
    "deploy:backend": "./infrastructure/scripts/deploy-backend.sh dev",
    "deploy:backend:dev": "./infrastructure/scripts/deploy-backend.sh dev",
    "deploy:backend:staging": "./infrastructure/scripts/deploy-backend.sh staging",
    "deploy:backend:prod": "./infrastructure/scripts/deploy-backend.sh prod",
    "deploy:all": "npm run build && npm run deploy:backend && npm run deploy:frontend",
    "demo:seed": "./scripts/demo/manage-demo.sh seed dev",
    "demo:seed:staging": "./scripts/demo/manage-demo.sh seed staging",
    "demo:cleanup": "./scripts/demo/manage-demo.sh cleanup dev",
    "demo:cleanup:staging": "./scripts/demo/manage-demo.sh cleanup staging",
    "demo:validate": "./scripts/demo/manage-demo.sh validate dev",
    "demo:validate:staging": "./scripts/demo/manage-demo.sh validate staging",
    "demo:prepare": "./scripts/demo/manage-demo.sh prepare dev",
    "demo:prepare:staging": "./scripts/demo/manage-demo.sh prepare staging"
  },
  "keywords": [
    "document",
    "processing",
    "aws",
    "lambda",
    "hackathon"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-comprehend": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.57.0",
    "typescript": "^4.5.5"
  }
}

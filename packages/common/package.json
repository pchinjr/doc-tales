{
  "name": "@doc-tales/common",
  "version": "0.1.0",
  "description": "Common utilities and types for Doc-Tales",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "test": "tape \"src/**/*.test.ts\" | tap-spec"
  },
  "dependencies": {
    "@aws-sdk/client-comprehend": "^3.32.0",
    "@aws-sdk/client-dynamodb": "^3.32.0",
    "@aws-sdk/client-s3": "^3.32.0",
    "@aws-sdk/client-textract": "^3.32.0"
  },
  "devDependencies": {
    "@types/node": "^17.0.21",
    "@types/tape": "^5.6.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "rimraf": "^5.0.0",
    "tap-spec": "^5.0.0",
    "tape": "^5.9.0",
    "ts-node": "^10.5.0",
    "typescript": "^4.5.5"
  }
}
